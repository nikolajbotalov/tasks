                    }
                }
            }
        },
        "domain.RegisterResponse": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                }
            }
        },
        "domain.Role": {
            "type": "string",
            "enum": [
                "viewer",
                "user",
                "admin"
