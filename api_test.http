### Register User
POST http://localhost:8080/api/auth/register HTTP/2
Content-Type: application/json
Accept: application/json

{
  "email": "test@example.com",
  "username": "test",
  "password": "test1234"
}

### Login User
POST http://localhost:8080/api/auth/login HTTP/2
Content-Type: application/json
Accept: application/json

{
  "email": "test@example.com",
  "password": "test1234"
}

> {%
    client.global.set("access_token", response.body.access_token)
%}

### Get all tasks
GET http://localhost:8080/api/tasks HTTP/2
Accept: application/json
Authorization: Bearer {{access_token}}

### Get all tasks with "to_do" status
GET http://localhost:8080/api/tasks?status=TO_DO HTTP/2
Accept: application/json
Authorization: Bearer {{access_token}}

### Get all tasks with "low" priority
GET http://localhost:8080/api/tasks?priority=low HTTP/2
Accept: application/json
Authorization: Bearer {{access_token}}

### Get task by ID
GET http://localhost:8080/api/tasks/2d43043c-a49e-407c-b955-0b82f76073a2
Accept: application/json
Authorization: Bearer {{access_token}}

### Create task
POST http://localhost:8080/api/tasks HTTP/2
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{access_token}}

{
  "name": "task 1",
  "description": "description first task"
}

### Update task
PUT http://localhost:8080/api/tasks/82af17ab-d4e7-4302-82e0-c07f2901f3ae
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{access_token}}

{
  "name": "task 5",
  "description": "description fifth task",
  "status": "IN_PROGRESS"
}

### Delete Task
DELETE http://localhost:8080/api/tasks/93c76532-981d-4ba7-83c6-061554c5d679
Accept: application/json
Authorization: Bearer {{access_token}}