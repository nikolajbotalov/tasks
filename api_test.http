### Register User
POST http://localhost:8080/api/v1/auth/register HTTP/2
Content-Type: application/json
Accept: application/json

{
  "email": "user@example.com",
  "username": "user",
  "password": "user1234"
}

### Login User
POST http://localhost:8080/api/v1/auth/login HTTP/2
Content-Type: application/json
Accept: application/json

{
  "email": "test@example.com",
  "password": "test1234"
}

> {%
    client.global.set("access_token", response.body.access_token)
%}

### Get all tasks
GET http://localhost:8080/api/v1/tasks HTTP/2
Accept: application/json
Authorization: Bearer {{access_token}}

### Get all tasks with "to_do" status
GET http://localhost:8080/api/v1/tasks?status=to_do HTTP/2
Accept: application/json
Authorization: Bearer {{access_token}}

### Get all tasks with "low" priority
GET http://localhost:8080/api/v1/tasks?priority=low HTTP/2
Accept: application/json
Authorization: Bearer {{access_token}}

### Get all tasks with search param
GET http://localhost:8080/api/v1/tasks?search=first
Accept: application/json
Authorization: Bearer {{access_token}}

### Get task by ID
GET http://localhost:8080/api/v1/tasks/2d43043c-a49e-407c-b955-0b82f76073a2
Accept: application/json
Authorization: Bearer {{access_token}}

### Create task
POST http://localhost:8080/api/v1/tasks HTTP/2
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{access_token}}

{
  "name": "task 1",
  "description": "description first task"
}

### Update task
PUT http://localhost:8080/api/v1/tasks/82af17ab-d4e7-4302-82e0-c07f2901f3ae
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{access_token}}

{
  "name": "task 5",
  "description": "description fifth task",
  "status": "in_progress"
}

### Delete Task
DELETE http://localhost:8080/api/v1/tasks/93c76532-981d-4ba7-83c6-061554c5d679
Accept: application/json
Authorization: Bearer {{access_token}}

### Get all user roles
GET http://localhost:8080/api/v1/users/roles
Accept: application/json
Authorization: Bearer {{access_token}}

### Update user role
PUT http://localhost:8080/api/v1/users/bba92bc0-faa6-470a-828b-26c30f44d449/roles
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{access_token}}

{
  "role": "viewer"
}
